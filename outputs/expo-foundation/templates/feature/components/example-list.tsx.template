import { Text, View } from 'react-native';
import { EmptyState, ErrorState, LoadingState } from '@/ui/feedback';
import { useExamples } from '../queries/use-examples';

export function ExampleList() {
  const query = useExamples();

  if (query.isPending) return <LoadingState />;
  if (query.isError) {
    return <ErrorState title="Não foi possível carregar" actionLabel="Tentar novamente" onAction={() => void query.refetch()} />;
  }
  if (!query.data.length) return <EmptyState title="Nenhum item por aqui" />;

  return <View>{query.data.map((item) => <Text key={item.id}>{item.title}</Text>)}</View>;
}

